# Copy to .env and fill in. NEVER commit real secrets (CLAUDE.md §7).

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-prod
DEBUG=1
ALLOWED_HOSTS=*
LOG_LEVEL=INFO
DEFAULT_CURRENCY=USD

# Postgres
POSTGRES_DB=sfms
POSTGRES_USER=sfms
POSTGRES_PASSWORD=sfms
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Celery / RabbitMQ
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# MinIO (S3-compatible)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sfms-media
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1
# Public host used in file URLs the browser loads (logos, photos). Internal
# server ops still use MINIO_ENDPOINT above.
MINIO_PUBLIC_DOMAIN=localhost:9000/sfms-media

# Object storage override — point uploads + backups at any S3-compatible store
# (e.g. Bunny.net S3). Leave unset to use the MinIO values above (dev default).
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_BUCKET=sfms-media
# STORAGE_ENDPOINT=https://storage.bunnycdn.com     # your Bunny.net S3 endpoint
# STORAGE_REGION=de
# STORAGE_ADDRESSING_STYLE=virtual                  # hosted providers usually want "virtual"
# STORAGE_PUBLIC_DOMAIN=your-zone.b-cdn.net          # CDN/public host for unsigned URLs
# STORAGE_URL_PROTOCOL=https:
# STORAGE_QUERYSTRING_AUTH=true                     # sign URLs for a private bucket

# Email — MSG91 SMTP relay.
# Leave EMAIL_HOST_USER blank in dev to use the console backend (emails print to logs).
EMAIL_HOST=smtp.msg91.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=YukiCares <no-reply@yukicares.cloud>
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend   # auto-selected when USER is set

# Links inside emails (password reset) point at the frontend.
FRONTEND_SCHEME=http
FRONTEND_PORT=5173

# Auth0 SSO (backend token validation). Leave blank to keep password-only login.
# AUTH0_DOMAIN is your tenant domain e.g. dev-xxxx.us.auth0.com
# AUTH0_AUDIENCE is your Auth0 API identifier (the API the SPA requests a token for).
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
# AUTH0_EMAIL_CLAIM=email   # override if email is under a namespaced custom claim

# Razorpay online payments + webhook auto-reconciliation.
# Leave RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET blank to disable (endpoints return 503).
# RAZORPAY_KEY_ID is the publishable key sent to the browser checkout widget.
# RAZORPAY_KEY_SECRET signs orders / verifies checkout signatures — keep it secret.
# RAZORPAY_WEBHOOK_SECRET verifies incoming webhook payloads (set it in the
# Razorpay dashboard webhook config); required for auto-reconciliation.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp — MSG91 WhatsApp API (payment receipts + fee due reminders).
# Leave MSG91_WHATSAPP_AUTHKEY / MSG91_WHATSAPP_NUMBER blank to DISABLE sending:
# messages are then logged (PII-safe) to the worker instead of dispatched — handy
# in dev for reading OTPs/receipts. Set both to enable real delivery.
# MSG91_WHATSAPP_AUTHKEY authenticates the API call (sent as the `authkey` header).
# MSG91_WHATSAPP_NUMBER is your MSG91 integrated (approved) WhatsApp number.
# MSG91_WHATSAPP_NAMESPACE is your WABA template namespace (optional; template use).
MSG91_WHATSAPP_AUTHKEY=
MSG91_WHATSAPP_NUMBER=
MSG91_WHATSAPP_NAMESPACE=

# Your WhatsApp Business number for verified support (digits + country code, no +).
SUPPORT_WHATSAPP_NUMBER=

# SMS — MSG91 SMS API (payment receipts + invoice-generated notices).
# Leave MSG91_SMS_AUTHKEY / MSG91_SMS_SENDER_ID blank to DISABLE sending:
# messages are then logged (PII-safe) to the worker instead of dispatched — handy
# in dev. Set both to enable real delivery.
# MSG91_SMS_AUTHKEY authenticates the API call (sent as the `authkey` header).
# MSG91_SMS_SENDER_ID is your 6-char DLT-approved sender id.
# MSG91_SMS_TEMPLATE_ID is your DLT-approved template id (required by Indian DLT).
MSG91_SMS_AUTHKEY=
MSG91_SMS_SENDER_ID=
MSG91_SMS_TEMPLATE_ID=
# Prefixed to bare 10-digit phone numbers when building an msisdn for sending.
SMS_DEFAULT_COUNTRY_CODE=91

# GST e-invoicing (India, optional). Set the IRP base URL + API creds to register
# real IRN/QR; leave blank to fall back to a deterministic mock (dev). GSTIN and
# supplier state default to the school's SchoolSettings when unset here.
GST_EINVOICE_BASE_URL=
GST_EINVOICE_API_USER=
GST_EINVOICE_API_PASSWORD=
GST_EINVOICE_GSTIN=
GST_SUPPLIER_STATE=
# Default charge levied on a dishonoured (bounced) cheque.
CHEQUE_BOUNCE_CHARGE=0

# Payroll statutory defaults (India). PF = rate × min(basic, ceiling); ESI = rate
# × gross while gross ≤ threshold; flat professional tax. Any component can be
# overridden per payout run.
PAYROLL_PF_RATE=0.12
PAYROLL_PF_WAGE_CEILING=15000
PAYROLL_ESI_EMPLOYEE_RATE=0.0075
PAYROLL_ESI_WAGE_THRESHOLD=21000
PAYROLL_PROFESSIONAL_TAX=200

# AI collections assistant (optional). With a key, /collections/assistant/ answers
# natural-language questions via Claude; without one it returns a rule-based summary.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Verified backups — where pg_dump writes dumps before the restore drill.
# (In prod, point at a mounted volume synced offsite; see CLAUDE.md §10.)
BACKUP_DIR=/tmp/sfms-backups

# Platform admin console (public schema, superuser-only). Move it off the
# well-known /admin/ path and optionally restrict by IP (comma-separated).
ADMIN_URL=admin/
ADMIN_IP_ALLOWLIST=
# Admin console idle timeout + sudo re-auth window (seconds).
ADMIN_SESSION_TIMEOUT=1800
ADMIN_REAUTH_WINDOW=600

# Sentry — backend (leave blank to disable). Active in prod settings only.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Sentry — frontend (leave blank to disable)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
