# Copy to .env and fill in. NEVER commit real secrets (CLAUDE.md §7).

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-prod
DEBUG=1
ALLOWED_HOSTS=*
LOG_LEVEL=INFO
DEFAULT_CURRENCY=USD

# Postgres
POSTGRES_DB=sfms
POSTGRES_USER=sfms
POSTGRES_PASSWORD=sfms
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Celery / RabbitMQ
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# MinIO (S3-compatible)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sfms-media
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1
# Public host used in file URLs the browser loads (logos, photos). Internal
# server ops still use MINIO_ENDPOINT above.
MINIO_PUBLIC_DOMAIN=localhost:9000/sfms-media

# Email — MSG91 SMTP relay.
# Leave EMAIL_HOST_USER blank in dev to use the console backend (emails print to logs).
EMAIL_HOST=smtp.msg91.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Fee Ledger <no-reply@feeledger.app>
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend   # auto-selected when USER is set

# Links inside emails (password reset) point at the frontend.
FRONTEND_SCHEME=http
FRONTEND_PORT=5173

# Auth0 SSO (backend token validation). Leave blank to keep password-only login.
# AUTH0_DOMAIN is your tenant domain e.g. dev-xxxx.us.auth0.com
# AUTH0_AUDIENCE is your Auth0 API identifier (the API the SPA requests a token for).
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
# AUTH0_EMAIL_CLAIM=email   # override if email is under a namespaced custom claim

# Sentry (leave blank to disable)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
