# Copy to frontend/.env to enable Auth0 SSO on the login screen.
# Leave blank to keep password-only login (the "Sign in with SSO" button is hidden).

# Auth0 SPA application (Single Page Application type) values:
VITE_AUTH0_DOMAIN=          # e.g. dev-xxxx.us.auth0.com
VITE_AUTH0_CLIENT_ID=       # the SPA app's Client ID
VITE_AUTH0_AUDIENCE=        # your Auth0 API identifier (must match backend AUTH0_AUDIENCE)

# Optional: override the derived API base (defaults to <page-host>:8000/api/v1).
# VITE_API_BASE_URL=
